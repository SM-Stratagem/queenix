# Keep build contexts small and secrets out of images.
.git
.muse
.fablize
**/node_modules
**/.next
**/.expo
**/dist
**/.turbo
**/test-results
**/playwright-report
**/.data
**/*.tsbuildinfo
apps/mobile/.export-*
services/ocr/.venv
services/ocr/**/__pycache__
# Secrets: never bake env files into images (examples are fine).
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.docx
LOGOFinalized.jpg
