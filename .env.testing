# ============================================================================
# Queenix Gym — TESTING environment + demo credentials
# ============================================================================
# How to use:
#   1. This file is the single source of truth for local testing.
#   2. Copy the values into the per-app env files (or run the commands
#      in the "Wire up" section below) then start the three services.
#   3. Sign the demo accounts up once (script in §4), then log in
#      anywhere (mobile app, mobile web, API) with the credentials in §3.
#
# Services (all local):
#   Web admin (Next.js) : http://localhost:3000
#   Mobile web (Expo)   : http://localhost:8081
#   Convex API          : http://127.0.0.1:3210   (site: http://127.0.0.1:3211)
#   Auth endpoint       : http://localhost:3000/api/auth/*  (BetterAuth + SQLite)
# ============================================================================

# --- 1. Service URLs ---------------------------------------------------------
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:3000
CONVEX_SITE_URL=http://127.0.0.1:3211
AUTH_BASE_URL=http://localhost:3000

# --- 2. Secrets (testing only — DO NOT reuse in production) ------------------
AUTH_SECRET=testing-secret-replace-before-production-min-32-chars-0123456789ab
# File-based auth DB (SQLite). No Postgres needed for testing.
AUTH_DB_PATH=.data/queenix-auth.db

# --- 3. Demo accounts (one per role, shared password for testing) ------------
DEMO_PASSWORD=QueenixDemo123!
DEMO_MEMBER_EMAIL=member@queenix.test
DEMO_MEMBER_NAME=Amna Member
DEMO_TRAINER_EMAIL=trainer@queenix.test
DEMO_TRAINER_NAME=Layla Trainer
DEMO_OWNER_EMAIL=owner@queenix.test
DEMO_OWNER_NAME=Sara Owner
DEMO_OPERATIONS_EMAIL=ops@queenix.test
DEMO_OPERATIONS_NAME=Khalid Ops

# --- 4. First-time setup (run once, from the repo root) -----------------------
# pnpm install
# Terminal 1 — Convex backend (leave running):
#   pnpm --filter @queenix/convex dev
# Terminal 2 — web admin + auth API (leave running):
#   pnpm --filter @queenix/web dev              # http://localhost:3000
# Terminal 3 — mobile app (leave running):
#   pnpm web                                    # http://localhost:8081, or press i/a for simulator
# Then create the DB tables (once) + the 4 demo accounts:
#   cd apps/web && pnpm dlx @better-auth/cli migrate --config ../../packages/auth/src/server.ts -y && cd ../..
#   node scripts/seed-demo-users.mjs            # signs up all 4 roles, links them to Convex
# (manual alternative) POST http://localhost:3000/api/auth/sign-up/email
# per account, then: cd packages/convex && npx convex run seed:seedDemoUsers ...
