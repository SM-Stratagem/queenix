FROM node:20-alpine
WORKDIR /app

# python3/make/g++: lets node-gyp compile nested native deps (better-sqlite3
# under @better-auth/cli has no musl/arm64 prebuilt binary).
RUN apk add --no-cache libc6-compat curl python3 make g++

COPY package.json package-lock.json .npmrc ./
COPY scripts scripts
COPY apps/web/package.json apps/web/
COPY packages packages
COPY apps apps

RUN npm install && node scripts/patch-tamagui-react19.mjs

ENV NODE_ENV=development
ENV PORT=3000
EXPOSE 3000

CMD ["npm", "run", "dev", "--workspace", "@queenix/web"]
