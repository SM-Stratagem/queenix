# Node 24 = Active LTS (Node 20 EOL'd 2026-04-30). Debian, not Alpine: native
# deps (better-sqlite3) ship glibc prebuilds; python3/make/g++ cover the rest.
FROM node:24-bookworm-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json .npmrc ./
COPY scripts scripts
COPY apps/web/package.json apps/web/
COPY packages packages
COPY apps apps

RUN npm install

ENV NODE_ENV=development
ENV PORT=3000
EXPOSE 3000

CMD ["npm", "run", "dev", "--workspace", "@queenix/web"]
