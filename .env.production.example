# Queenix Gym — production environment, per service.
# Copy to .env.production (gitignored) and fill it in:  cp .env.production.example .env.production
# Railway: paste each section into that service's Variables → Raw Editor.
# [auto] = already set by .railway/railway.ts on Railway; only needed on AWS / elsewhere.
# The web server refuses to start with a missing or weak required value and lists them all.

# ============================================================================
# web  (Next.js staff console + auth/OTP/payments/scanner/OCR APIs)
# ============================================================================

# --- Secrets: generate with `node scripts/gen-secrets.mjs` -------------------
AUTH_SECRET=
AUTH_JWKS=
QUEENIX_ADMIN_TOKEN=
SCANNER_API_KEY=
OCR_API_KEY=                     # same value in the ocr service

# --- Convex admin key: after the convex service is up, run ./generate_admin_key.sh
#     inside it (Railway: `railway ssh -s convex`). Same value in convex-deploy.
CONVEX_DEPLOY_KEY=

# --- Email (any SMTP provider). Verify your sending domain (SPF/DKIM). -------
#   Resend    smtps://resend:<API_KEY>@smtp.resend.com:465
#   AWS SES   smtps://<SMTP_USER>:<SMTP_PASS>@email-smtp.<region>.amazonaws.com:465
#   SendGrid  smtps://apikey:<API_KEY>@smtp.sendgrid.net:465
#   Postmark  smtp://<SERVER_TOKEN>:<SERVER_TOKEN>@smtp.postmarkapp.com:587
SMTP_URL=
EMAIL_FROM="Queenix Gym <no-reply@yourdomain.com>"

# --- SMS (Twilio). UAE numbers need a registered alphanumeric sender ID. ----
SMS_PROVIDER=twilio              # [auto]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                     # +1xxxxxxxxxx or approved sender ID, e.g. QUEENIX

# --- Online card payments (optional until you take card payments) ----------
# AED uses Tap when TAP_SECRET_KEY is set, otherwise Stripe. Without keys,
# online checkout errors; counter/cash payments still work.
# Leave PAYMENTS_PROVIDER unset (mock is refused in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=           # Stripe webhook → https://<web>/api/payments/stripe/webhook
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=              # Tap webhook → https://<web>/api/payments/tap/webhook

# --- Receipts (optional) ----------------------------------------------------
QUEENIX_VAT_NUMBER=              # TRN printed on receipts
QUEENIX_LOGO_URL=                # https URL of the logo on receipts

# --- Door / fingerprint scanners (optional) --------------------------------
# Comma-separated device IDs. Empty = any device holding SCANNER_API_KEY.
ALLOWED_SCANNER_DEVICES=
FINGERPRINT_DEVICE_IDS=

# --- URLs and wiring [auto on Railway] --------------------------------------
AUTH_BASE_URL=https://app.yourdomain.com          # public web URL (https ⇒ secure cookies)
NEXT_PUBLIC_CONVEX_URL=https://api.yourdomain.com # public Convex URL — baked in at BUILD time
DATABASE_URL=postgres://user:pass@host:5432/queenix_auth
CONVEX_SELF_HOSTED_URL=http://convex:3210         # private Convex URL
OCR_URL=http://ocr:8000                           # private OCR URL
AUTH_IP_HEADER=x-real-ip   # header your edge OVERWRITES: Railway x-real-ip, Cloudflare cf-connecting-ip
AUTH_TRUSTED_PROXIES=       # AWS ALB etc.: proxy CIDRs (e.g. 10.0.0.0/16); x-forwarded-for is then read right-to-left. Never trust raw x-forwarded-for.
PORT=3000

# ============================================================================
# convex  (self-hosted Convex backend)
# ============================================================================
INSTANCE_SECRET=                 # openssl rand -hex 32 — never change it after launch
# [auto on Railway]
# INSTANCE_NAME=railway          # Convex uses the Postgres database with this name
# POSTGRES_URL=postgresql://user:pass@convex-postgres-host:5432   (no database name)
# DO_NOT_REQUIRE_SSL=1
# CONVEX_CLOUD_ORIGIN=https://api.yourdomain.com
# CONVEX_SITE_ORIGIN=https://api.yourdomain.com/http
# PORT=3210

# ============================================================================
# convex-deploy  (one-shot job each release: pushes Convex functions)
# ============================================================================
CONVEX_SELF_HOSTED_ADMIN_KEY=    # = CONVEX_DEPLOY_KEY
# [auto on Railway]
# CONVEX_SELF_HOSTED_URL=http://convex:3210
# AUTH_BASE_URL=https://app.yourdomain.com
# APP_URL=https://app.yourdomain.com

# ============================================================================
# ocr  (private OCR service)
# ============================================================================
# OCR_API_KEY=                   # = web OCR_API_KEY
# OCR_THREADS=2                  # [auto]

# ============================================================================
# mobile  (EAS — `npx eas-cli env:create --environment production ...`)
# ============================================================================
# EXPO_PUBLIC_AUTH_BASE_URL=https://app.yourdomain.com
# EXPO_PUBLIC_CONVEX_URL=https://api.yourdomain.com
