{
  "name": "queenix-gym",
  "version": "1.0.0",
  "private": true,
  "description": "Queenix Gym - women's gym platform (Member, Trainer, Owner, Operations) with web admin",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,mobile -c blue,magenta \"npm run dev --workspace @queenix/web\" \"npm run start --workspace @queenix/mobile\"",
    "dev:web": "npm run dev --workspace @queenix/web",
    "dev:mobile": "npm run start --workspace @queenix/mobile",
    "dev:convex": "npm run dev --workspace @queenix/convex",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "seed": "node scripts/seed-demo-users.mjs",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "postinstall": "node scripts/init-env.mjs",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .expo .turbo .data/*.db* *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "concurrently": "^10.0.5",
    "railway": "^3.12.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
