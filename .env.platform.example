# Queenix Gym - platform/docker local-run example env.
# Copy to .env (never commit real secrets):  cp .env.platform.example .env

# --- Postgres (compose `db` service) ---
POSTGRES_USER=queenix
POSTGRES_PASSWORD=queenix-dev-only
POSTGRES_DB=queenix
POSTGRES_PORT=5432
DATABASE_URL=postgresql://queenix:queenix-dev-only@localhost:5432/queenix

# --- Auth (BetterAuth, used by packages/auth + apps/web) ---
AUTH_SECRET=testing-secret-replace-before-production-min-32-chars-0123456789ab
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Local sqlite path used only when DATABASE_URL is unset (see db-pg.ts fallback).
AUTH_DB_PATH=./.data/queenix-auth.db

# --- Web / Convex ---
WEB_PORT=3000
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210
CONVEX_SELF_HOSTED_URL=http://localhost:3210
CONVEX_SITE_URL=http://localhost:3211

# --- Expo (mobile runs on HOST Expo Go, not in compose - see DOCKER.md) ---
# Point these at your machine LAN IP so the phone can reach the compose network.
EXPO_PUBLIC_CONVEX_URL=http://localhost:3210
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:3000

# --- Payments (TODO-connect: paste real keys before any live charge test) ---
TAP_SECRET_KEY=TODO-connect-tap-secret-key
STRIPE_SECRET_KEY=TODO-connect-stripe-secret-key
PAYMENTS_PROVIDER=mock

# --- Admin seeding ---
QUEENIX_ADMIN_TOKEN=queenix-dev-admin-token
